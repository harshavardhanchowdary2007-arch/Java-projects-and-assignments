
public class Q05 {
    public static void main(String[] args) {

        // Widening conversion
        int a = 100;
        double b = a;

        System.out.println("Widening: " + b);

        // Narrowing conversion
        double x = 99.99;
        int y = (int) x;

        System.out.println("Narrowing: " + y);
    }
}
