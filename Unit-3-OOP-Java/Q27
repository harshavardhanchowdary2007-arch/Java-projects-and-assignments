
enum Day {
    MONDAY, TUESDAY, WEDNESDAY,
    THURSDAY, FRIDAY, SATURDAY, SUNDAY
}

public class Q27 {
    public static void main(String[] args) {

        Day today = Day.MONDAY;

        System.out.println("Today: " + today);

        for (Day d : Day.values()) {
            System.out.println(d);
        }
    }
}
