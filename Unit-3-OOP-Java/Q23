
class Employee {
    int id;
    String name;

    Employee(int i, String n) {
        id = i;
        name = n;
    }

    void display() {
        System.out.println("ID: " + id);
        System.out.println("Name: " + name);
    }
}

public class Q23 {
    public static void main(String[] args) {

        Employee e1 = new Employee(101, "Ravi");

        e1.display();
    }
}
